rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /textileClickStats/{statId} {
      function hasValidClickData() {
        return request.resource.data.keys().hasOnly(['textileId', 'day', 'clicks'])
          && request.resource.data.keys().hasAll(['textileId', 'day', 'clicks'])
          && request.resource.data.textileId in [
            'wax-royal',
            'bazin-prestige',
            'bogolan-moderne',
            'kente-traditionnel'
          ]
          && request.resource.data.day is string
          && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.clicks is int;
      }

      allow read: if true;
      allow create: if hasValidClickData() && request.resource.data.clicks == 1;
      allow update: if hasValidClickData()
        && request.resource.data.textileId == resource.data.textileId
        && request.resource.data.day == resource.data.day
        && request.resource.data.clicks == resource.data.clicks + 1;
      allow delete: if false;
    }
  }
}
